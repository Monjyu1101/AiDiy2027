# Project specific directories
# Code / IDE がプロジェクト内に保存する会話・検索・解析の実行記録。
**/_AIDIY/aidiy_*/
# 旧保存先も公開しない。読込・自動移行はしない。
.aidiy/
# 環境診断（aidiy_diag）の出力。インストール状況・モデル情報は PC ごとの個別環境データ。
**/_AIDIY/aidiy_diag/
_cache/
.aidiy_cache/

# docs に集約したセルフテスト証拠は、追加分も含めて収録する。
!/docs/セルフテスト、操作ガイド/evidence/.aidiy_cache/
!/docs/セルフテスト、操作ガイド/evidence/.aidiy_cache/**
# 実画面試験の保存領域に混入する GPU キャッシュは証拠に含めない。
/docs/セルフテスト、操作ガイド/evidence/**/LocalLow/Intel/ShaderCache/

_controls/
_datas/
.aidiy_backup/
# 旧保存版も公開しない。自動移動・削除はしない。
.backup_local/
# ローカル専用の Git 履歴は親リポジトリにも登録しない（全階層）。
.git_local/
julius/
_MCP/

# Secrets / sensitive
# ローカル AWS / Codex の資格情報。ソース・伏せ字処理のテストは除外しない。
.aws/
**/.codex/auth.json
**/.codex/auth.json.*
# 全階層の内部認証情報と、同一ディレクトリで原子的に保存する際の一時ファイル。
internal_auth.json
.internal_auth.json.*.tmp
internal_auth_keys.json
.internal_auth_keys.json.*.tmp
.internal_auth_keys.lock
# NOTE: ここでは「実際の資格情報ファイル」だけを対象にする。
#       *key* / *secret* のような広いパターンは、
#       command_hermes/core/secret_scope.py や
#       command_hermes/gateway/platforms/qqbot/keyboards.py のような
#       通常のソースモジュールまで除外してしまうため使用しない。
*.key
*.pem
*.pfx
*.p12
*.keystore
*_key.json
*_keys.json
*_apikey.json
*_api_key.json
*_secret.json
*_secrets.json
*_credential.json
*_credentials.json
.secrets
.secrets.*
AZiP*.*
firiend*

# Pi: setup が生成するモデルデータ（npm run hydrate:model-data）
command_pi/packages/ai/src/providers/data/

# Rust（cargo）: ビルド成果物は保管しない。command_codex 以外の Rust ワークスペースにも共通で適用する。
# Cargo.lock はアプリの依存固定に使うため除外しない。
**/target/
**/*.rs.bk
*.pdb

# 同梱ソース（command_codex / command_pi）のうち、上の一般パターンに一致してしまう正規ファイルを戻す。
# Windows の core.ignorecase では env/ が packages/env/ に、MANIFEST が manifest/ にも一致する。
!command_codex/codex-rs/core-plugins/src/manifest/
!command_codex/codex-rs/http-client/tests/fixtures/*.pem
!command_codex/codex-rs/vendor/bubblewrap/packaging/bubblewrap.spec
!command_codex/codex-rs/windows-sandbox-rs/codex-windows-sandbox-setup.manifest
!command_pi/apps/p2/plugins/logs/
!command_pi/packages/env/
!command_pi/packages/durable/src/env/
!command_pi/packages/coding-agent/examples/extensions/doom-overlay/doom/build/
