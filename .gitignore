# Distribution / packaging
# NOTE: lib / var / parts などの一般名は、リポジトリ直下に限定する。
#       未限定にすると command_hermes/scripts/lib のような通常ディレクトリまで除外される。
.Python
build/
dist/
/develop-eggs/
/downloads/
/eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
